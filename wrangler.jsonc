{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "healthresourceintiative",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-24",
  "observability": {
    "enabled": true
  },
  // Optional enrichment for HRSA Health Center web services:
  // wrangler secret put HRSA_API_TOKEN
  // Optional contact email passed to Nominatim per its usage policy:
  // wrangler secret put NOMINATIM_CONTACT_EMAIL
  "assets": {
    "directory": "healthlitapp",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
