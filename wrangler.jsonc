{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "healthresourceintiative",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-24",
  "observability": {
    "enabled": true
  },
  // Secrets — set via Cloudflare dashboard or: npx wrangler secret put <NAME>
  // Required:  GROQ_API_KEY
  // Optional:  HRSA_API_TOKEN, NOMINATIM_CONTACT_EMAIL
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_flags": ["nodejs_compat"]
}
