{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "healthresourceintiative",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-24",
  "observability": {
    "enabled": true
  },
  // Set this as a Cloudflare Worker secret:
  // wrangler secret put GOOGLE_MAPS_API_KEY
  // Optional future hook: wrangler secret put HRSA_API_TOKEN
  "assets": {
    "directory": "healthlitapp",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
